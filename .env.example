# Copy to .env.local. All variables below are server-only.
SUPABASE_URL=https://your-project.supabase.co
# Publishable key (legacy SUPABASE_ANON_KEY is also accepted).
SUPABASE_PUBLISHABLE_KEY=
# Secret key (legacy SUPABASE_SERVICE_ROLE_KEY is also accepted).
# Never prefix this key with NEXT_PUBLIC_ or put it in browser code.
SUPABASE_SECRET_KEY=
# Optional canonical origin for deployed API write requests.
# Leave APP_URL unset on Vercel to support each preview/production request origin.
APP_URL=http://localhost:3000
# Local initialization only, not required by Vercel runtime. Use the exact Session Pooler URI.
DATABASE_URL=
# Optional trusted CA certificate file; never disable TLS verification.
DATABASE_CA_FILE=

# Customer Session & SMS OTP Configuration
# Optional dedicated secret for customer HMAC tokens (falls back to SUPABASE_SECRET_KEY)
CUSTOMER_SESSION_SECRET=

# SMS Provider Options (Twilio, eSMS.vn, SpeedSMS, or Generic Gateway):
# 1. Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# 2. eSMS.vn:
# ESMS_API_KEY=
# ESMS_SECRET_KEY=
# ESMS_BRAND_NAME=PhoThinBoHo

# 3. SpeedSMS.vn:
# SPEEDSMS_ACCESS_TOKEN=
# SPEEDSMS_SENDER=PhoThinBoHo

# 4. Custom SMS Gateway / Webhook:
# SMS_GATEWAY_URL=
# SMS_GATEWAY_API_KEY=

