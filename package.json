{
  "name": "pho-thin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test src/lib/server/backend.test.ts tests/catalog.test.ts && node --import tsx --test tests/loading.test.tsx",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "test:loading": "python -I tests/loading_playwright.py",
    "db:check": "bun scripts/init-db.mjs --check",
    "db:init": "bun scripts/init-db.mjs --apply",
    "db:security": "bun scripts/init-db.mjs --smoke"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
